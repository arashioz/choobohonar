PORT=3001

# Compose replaces these two values with the internal Docker service names.
MONGODB_URI=mongodb://mongo:27017/choob-va-honar
REDIS_URL=redis://redis:6379

# Public origins allowed to submit forms and authenticate.
FRONTEND_URL=http://SERVER_IP

# Change both values before the first production boot.
ADMIN_USER=choobhonar
ADMIN_PASS=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ParsGreen REST v2 — keep this server-only; never expose it as NEXT_PUBLIC_*
PARSGREEN_API_KEY=
PARSGREEN_BASE_URL=https://sms.parsgreen.ir/Apiv2
# Optional approved ParsGreen OTP template. Keep 0 for the panel default.
PARSGREEN_OTP_TEMPLATE_ID=0
PARSGREEN_OTP_ADD_NAME=true

LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
